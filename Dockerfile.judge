# Pinned, not `latest`.
#
# The backend already depends on go-judge behaviour introduced in v1.11: it
# reads its cgroup parent from /proc/self/cgroup, and an older image gets
# "cgroup path is empty" and a fatal restart loop. Floating on `latest` meant a
# cluster upgrade could change that behaviour or the /run wire format with no
# change on our side and no way to reproduce yesterday's binary.
#
# Bump this tag deliberately, with a sandbox smoke test (see docs/DEPLOYMENT.md).
FROM criyle/go-judge:v1.11.4
# g++-multilib / gcc-multilib are what make the *-32 languages work. Without
# them `gcc -m32` cannot find the 32-bit crt objects or libgcc and every 32-bit
# compile fails, while 64-bit compiles keep succeeding — which is how this
# shipped broken. The admin panel's tool list mirrors this image, so keep the
# two in step when adding a compiler.
#
# clang matters for the same reason: `lang/cpp-clang.yaml` ships and the UI
# offers "C++ (Clang)", but the image never installed it, so that language was
# unselectable-in-practice from the day it was added.
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ gcc g++-multilib gcc-multilib libc6-dev-i386 make \
    clang \
    python3 pypy3 \
    openjdk-21-jdk-headless \
    rustc cargo \
    nodejs npm \
    mono-mcs mono-runtime \
    && rm -rf /var/lib/apt/lists/*

# Replace the vendor sandbox mount list. go-judge reads MountConf as the whole
# mount table, not an overlay, and the vendor copy binds /bin /lib /lib64 /usr
# without /lib32 — so `gcc -m32` linked against a /lib32/libc.so.6 that the
# sandbox never exposed:
#
#   /usr/bin/ld: cannot find /lib32/libc.so.6: No such file or directory
#   /usr/bin/ld: cannot find /lib/ld-linux.so.2: No such file or directory
#
# Installing multilib alone cannot fix it: the packages were always present and
# only the mount was missing, which is why a host-side `gcc -m32` succeeded while
# every submission failed. deploy/judge/mount.yaml is the vendor file plus the
# /lib32 bind, and keeping it in the repo makes the delta reviewable.
COPY deploy/judge/mount.yaml /opt/mount.yaml

# Verify the two halves of 32-bit support agree — multilib installed, and the
# mount file we ship actually exposing it. Deliberately static: a compile here
# runs on the image's own filesystem and would succeed even with the mount file
# broken, which is the false confidence that let this ship. The live check is
# the sandbox smoke test in docs/DEPLOYMENT.md; this only catches the pieces
# drifting apart at build time.
RUN test -e /lib32/libc.so.6 \
    && test -e /lib/ld-linux.so.2 \
    && grep -qE '^[[:space:]]*source:[[:space:]]*/lib32$' /opt/mount.yaml \
    && grep -qE '^[[:space:]]*target:[[:space:]]*/lib32$' /opt/mount.yaml \
    || { echo "sandbox mount.yaml must expose /lib32 for the 32-bit languages; see deploy/judge/mount.yaml" >&2; exit 1; }
