# "production" (default) or "development". Development mounts /api/dev/mail and
# only warns about weak secrets; production refuses to boot with them.
environment: "production"
server:
  host: "0.0.0.0"
  port: 8080
  metrics_token: ""           # override with METRICS_TOKEN; /metrics is admin-only when empty
  # Shared token for the ICPC-style event feed an external scorer polls. Empty
  # disables the feed (the endpoint answers 503 rather than serving it to anyone).
  feed_token: ""              # override with FEED_TOKEN
database:
  host: "localhost"
  port: 5432
  user: "aioj"
  password: "changeme"        # override with DB_PASSWORD env var
  name: "aioj"
  max_open: 25
  max_idle: 5
  # Apply pending migrations at startup. Every container boots the same binary,
  # so all of them migrate; a database advisory lock serializes it. Set false on
  # instances that should only serve (a rolling restart, or a deployment with a
  # dedicated migrate job) so a schema change never races a live process.
  migrate_on_boot: true
  # Repair a schema version left dirty by a migration that failed and rolled
  # back. Only the newest-version case is auto-repaired; a dirty version below
  # the newest is always refused, because the schema's real shape is unknown.
  # Leave false to inspect failures by hand instead.
  migrate_auto_recover: false
auth:
  csrf_secret: ""  # override with CSRF_SECRET
  jwt_secret: "change-me-in-production"  # override with JWT_SECRET env var — set a long random value in production
  access_ttl: 15m
  refresh_ttl: 168h
judge:
  endpoint: "http://localhost:5050"
  concurrency: 4
  max_code_size: 262144
  # Pressure gate + requirement-aware admission. Both thresholds at 0 disables
  # the gate entirely; compose sets sane values for production.
  #   min_free_mem_mb:   flat floor; pause when MemAvailable drops below it.
  #   max_load_per_cpu:  pause when (1-min loadavg / numCPU) exceeds this ratio.
  #   mem_headroom_mb:   slack required on top of a judgment's own limit.
  #   max_judgment_mem_mb: largest per-judgment requirement to attempt, AFTER the
  #     language multiplier (Java's is 2.0). A submission above it fails with an
  #     explanatory verdict instead of queueing forever. 0 means 3072.
  min_free_mem_mb: 512
  max_load_per_cpu: 1.5
  mem_headroom_mb: 256
  max_judgment_mem_mb: 3072
redis:
  url: "localhost:6379"       # leave empty to use in-memory judge queue
ai:
  enabled: false                 # env AI_ENABLED; enable after setting the master key
  credential_master_key: ""   # env AI_CREDENTIAL_MASTER_KEY; base64 32 bytes
  worker_concurrency: 2
  job_timeout_seconds: 300
  max_response_bytes: 4194304
  retention_days: 14
  staged_testdata_root: "./testdata/ai-staging"
  # Multi-turn generator pipeline (internal/harness). Off keeps the single-shot
  # JSON path; on runs the tool loop that materializes large cases by executing
  # generated code instead of asking the model to type them.
  harness: false              # env AI_HARNESS_ENABLED
  max_case_n: 1000000         # env AI_MAX_CASE_N — bounds the largest test case
  max_job_bytes: 67108864     # env AI_MAX_JOB_BYTES — 64 MiB of materialized data per job
  repair_turns: 2             # env AI_REPAIR_TURNS — retries after a failed gate
mail:
  driver: "catcher"           # smtp | catcher | noop — override with MAIL_DRIVER
  host: ""
  port: 587
  username: ""
  password: ""                # override with MAIL_PASSWORD
  from: "noreply@aioj.com"    # override with MAIL_FROM
  public_url: "http://localhost:8081"  # override with MAIL_PUBLIC_URL / PUBLIC_ORIGIN
oauth:
  state_secret: ""            # override with OAUTH_STATE_SECRET
  github:
    client_id: ""             # override with GITHUB_CLIENT_ID
    client_secret: ""         # override with GITHUB_CLIENT_SECRET
    redirect_url: "http://localhost:8081/api/auth/oauth/github/callback"
  google:
    client_id: ""             # override with GOOGLE_CLIENT_ID
    client_secret: ""         # override with GOOGLE_CLIENT_SECRET
    redirect_url: "http://localhost:8081/api/auth/oauth/google/callback"
lang_dir: "./lang"

# Out-of-process submit services. Codeforces and AtCoder both need a real browser
# session to submit, which the judge's HTTP client cannot hold, so each has a
# small separate service. These were previously read from the environment in
# main() with the defaults inlined there, which left them out of this file.
remote_judge:
  cf_submit_url: "http://host.docker.internal:8003"       # override with CF_SUBMIT_URL
  atcoder_submit_url: "http://host.docker.internal:8004"  # override with ATCODER_SUBMIT_URL
