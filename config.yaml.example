server:
  host: "0.0.0.0"
  port: 8080
database:
  host: "localhost"
  port: 5432
  user: "aioj"
  password: "changeme"        # override with DB_PASSWORD env var
  name: "aioj"
  max_open: 25
  max_idle: 5
auth:
  csrf_secret: ""  # override with CSRF_SECRET
  jwt_secret: "change-me-in-production"  # override with JWT_SECRET env var — set a long random value in production
  access_ttl: 15m
  refresh_ttl: 168h
judge:
  endpoint: "http://localhost:5050"
  concurrency: 4
  max_code_size: 262144
redis:
  url: "localhost:6379"       # leave empty to use in-memory judge queue
mail:
  driver: "catcher"           # smtp | catcher | noop — override with MAIL_DRIVER
  host: ""
  port: 587
  username: ""
  password: ""                # override with MAIL_PASSWORD
  from: "noreply@aioj.com"    # override with MAIL_FROM
  public_url: "http://localhost:8081"  # override with MAIL_PUBLIC_URL / PUBLIC_ORIGIN
oauth:
  state_secret: ""            # override with OAUTH_STATE_SECRET
  github:
    client_id: ""             # override with GITHUB_CLIENT_ID
    client_secret: ""         # override with GITHUB_CLIENT_SECRET
    redirect_url: "http://localhost:8081/api/auth/oauth/github/callback"
  google:
    client_id: ""             # override with GOOGLE_CLIENT_ID
    client_secret: ""         # override with GOOGLE_CLIENT_SECRET
    redirect_url: "http://localhost:8081/api/auth/oauth/google/callback"
lang_dir: "./lang"
