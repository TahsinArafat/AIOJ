# AIOJ Production Caddyfile
# ===========================
# Caddy automatically obtains and renews SSL certificates from Let's Encrypt.
# You only need to change the domain name below.

# --- Replace with your actual domain ---
yourdomain.com {
    # Reverse proxy all traffic to the frontend container (Nginx serving React SPA)
    reverse_proxy frontend:80

    # Optional: Enable gzip compression for faster page loads
    encode gzip zstd

    # --- Phase C: CDN / per-locale caching -------------------------------
    # Locale JSON is content-hashed by Vite in production (or immutable under
    # /assets/). Serve long-cache at the edge; SPA shell stays short-cache.
    header /assets/* Cache-Control "public, max-age=31536000, immutable"
    header *.woff2 Cache-Control "public, max-age=31536000, immutable"
    header *.woff Cache-Control "public, max-age=31536000, immutable"
    header *.ttf Cache-Control "public, max-age=31536000, immutable"
    header /index.html Cache-Control "no-cache, must-revalidate"
    # Media (problem images) — long cache, purge via /api/admin/cdn/purge
    header /media/* Cache-Control "public, max-age=604800"
    # ---------------------------------------------------------------------

    # Optional: Security headers (uncomment for production)
    # header {
    #     X-Content-Type-Options "nosniff"
    #     X-Frame-Options "DENY"
    #     Referrer-Policy "strict-origin-when-cross-origin"
    # }

    # Optional: Log requests (uncomment to debug)
    # log {
    #     output file /var/log/caddy/access.log
    # }
}

# --- Subdomain example (uncomment if you also want www) ---
# www.yourdomain.com {
#     redir https://yourdomain.com{uri} permanent
# }
