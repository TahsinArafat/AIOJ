{
  "openapi": "3.0.3",
  "info": {
    "title": "AIOJ API Documentation",
    "description": "API Reference for AIOJ (Lightweight Online Judge). The base URL for all endpoints is `/api`.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Local server relative path"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Log in and obtain JWT access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "refresh_token": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/problems": {
      "get": {
        "summary": "List all public problems",
        "parameters": [
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "difficulty", "in": "query", "schema": { "type": "string" } },
          { "name": "tags", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "type": "object" } },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/problems/my": {
      "get": {
        "summary": "List problems created by or shared with the authenticated user",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/contests/my": {
      "get": {
        "summary": "List contests managed by the authenticated user",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/gym": {
      "get": {
        "summary": "List gym contests",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/gym/{id}/solved": {
      "get": {
        "summary": "Check solved status of gym contest",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/groups/my": {
      "get": {
        "summary": "List groups the authenticated user belongs to",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/groups/{id}/contests": {
      "get": {
        "summary": "List contests associated with a group",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/blog": {
      "get": {
        "summary": "List blog posts",
        "parameters": [
          { "name": "offset", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "tag", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/blog/{id}/vote": {
      "get": {
        "summary": "Get authenticated user's vote status for a blog post",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "default": "blog" } }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}