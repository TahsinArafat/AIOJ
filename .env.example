# Copy this file to .env and fill in the values
DB_PASSWORD=aioj_secret
JWT_SECRET=change-me-in-production-use-a-long-random-string
JUDGE_CONCURRENCY=4
# Requirement-aware admission. A judgment is dispatched only when free RAM covers
# its own limit (after the language multiplier) plus the headroom, so a large
# problem waits for a large amount of free memory instead of the flat floor.
JUDGE_MEM_HEADROOM_MB=256
# Largest per-judgment requirement to attempt, AFTER the language multiplier
# (Java's is 2.0, so a 2 GB Java problem needs 4096). Above this the submission
# fails with an explanatory verdict instead of queueing forever.
JUDGE_MAX_JUDGMENT_MEM_MB=3072
# --- transactional email -------------------------------------------------
# smtp | catcher | noop. catcher/noop never deliver: they capture in memory or
# discard outright, so verification and password-reset links silently disappear.
# Set smtp with real credentials in any environment users must receive mail from.
MAIL_DRIVER=catcher
# Brevo: host smtp-relay.brevo.com, port 587 (STARTTLS) or 465 (implicit TLS).
# MAIL_USERNAME is your Brevo account login; MAIL_PASSWORD is an SMTP key from
# Brevo → SMTP & API → SMTP keys (NOT your account password).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be an address on a domain you have authenticated in Brevo (SPF + DKIM),
# or the provider will reject the send.
MAIL_FROM=noreply@aioj.com
# Base URL used to build links inside emails. Must be reachable by the recipient.
MAIL_PUBLIC_URL=http://localhost:8081
OAUTH_STATE_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the console registration exactly, e.g.
# https://your-domain/api/auth/oauth/google/callback
GOOGLE_REDIRECT_URL=
GITHUB_REDIRECT_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
AIOJ_RELEASE=dev
VITE_SENTRY_DSN=
VITE_AIOJ_RELEASE=dev
