# Copy this file to .env and fill in the values
DB_PASSWORD=aioj_secret
JWT_SECRET=change-me-in-production-use-a-long-random-string
JUDGE_CONCURRENCY=4
# Requirement-aware admission. A judgment is dispatched only when free RAM covers
# its own limit (after the language multiplier) plus the headroom, so a large
# problem waits for a large amount of free memory instead of the flat floor.
JUDGE_MEM_HEADROOM_MB=256
# Largest per-judgment requirement to attempt, AFTER the language multiplier
# (Java's is 2.0, so a 2 GB Java problem needs 4096). Above this the submission
# fails with an explanatory verdict instead of queueing forever.
JUDGE_MAX_JUDGMENT_MEM_MB=3072
OAUTH_STATE_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the console registration exactly, e.g.
# https://your-domain/api/auth/oauth/google/callback
GOOGLE_REDIRECT_URL=
GITHUB_REDIRECT_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
AIOJ_RELEASE=dev
VITE_SENTRY_DSN=
VITE_AIOJ_RELEASE=dev
